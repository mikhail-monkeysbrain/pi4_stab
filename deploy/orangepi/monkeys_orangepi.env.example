export PATH="$HOME/uart-test-venv/bin:$PATH"
export MONKEYS_FC_UART=/dev/ttyS5
export MONKEYS_FC_BAUD=460800
export MONKEYS_FC_TCP_PORT=5760
export MONKEYS_GCS_UDP_PORT=14550
export MONKEYS_FC=tcp://127.0.0.1:5760
export MONKEYS_LUNA=/dev/ttyS3
export MONKEYS_CAMERA=/dev/v4l/by-id/usb-Arducam_Technology_Co.__Ltd._Arducam_OV9281_USB_Camera_UC762-video-index0
export MONKEYS_CAMERA_YAML="$HOME/monkeysStab_orangepi/config/ov9281_current_mount.yaml"
export MONKEYS_LOCAL_GUI=0
export MONKEYS_WEB_PORT=8080
export MONKEYS_RUN_ROOT="$HOME/monkeysStab_runs"
export MONKEYS_RADXA_PREBUILT=0
export MONKEYS_FAST_RESTART=1
export MONKEYS_PARALLEL_GFTT=1
export MONKEYS_GFTT_VERIFY=0
export MONKEYS_VTX_PROTOCOL=TRAMP
